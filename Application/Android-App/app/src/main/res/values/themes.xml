<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ✅ App-wide blue theme -->
    <style name="Theme.EVApp" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/sea_blue</item>
        <item name="colorPrimaryDark">@color/sea_blue_dark</item>
        <item name="colorAccent">@color/sea_blue</item>
        <item name="colorControlHighlight">@color/sea_blue_light</item>

        <!-- Apply our custom blue button globally -->
        <item name="buttonStyle">@style/EvPrimaryButton</item>
    </style>

    <!-- ✅ Custom blue button style -->
    <style name="EvPrimaryButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/btn_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:backgroundTint">@null</item>
        <item name="backgroundTint">@null</item>
        <item name="tint">@null</item>
        <item name="android:tint">@null</item>
        <item name="colorControlHighlight">@color/sea_blue_light</item>
    </style>

</resources>
