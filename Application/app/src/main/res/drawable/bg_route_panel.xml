<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Light background for route panel -->
    <solid android:color="@color/sea_blue_verylight" />
    <!-- Rounded corners for card style -->
    <corners android:radius="12dp" />
    <!-- Subtle border using light sea blue -->
    <stroke android:width="1dp" android:color="@color/sea_blue_light" />
    <!-- Internal padding -->
    <padding
        android:left="12dp"
        android:top="12dp"
        android:right="12dp"
        android:bottom="12dp" />
</shape>
