<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- BACK BUTTON -->
        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← BACK"
            android:textColor="@color/white"
            android:background="@drawable/btn_primary"
            android:layout_marginBottom="16dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp" />

        <!-- STATION NAME & STATUS HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:padding="16dp"
            android:elevation="2dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvStatusEmoji"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🟢"
                    android:textSize="32sp"
                    android:layout_marginEnd="12dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Station Name"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#311B92" />

                    <TextView
                        android:id="@+id/tvAvailability"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Available"
                        android:textSize="14sp"
                        android:textColor="#4CAF50"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- PORT INFORMATION SECTION -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚡ Charging Ports"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#311B92"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:id="@+id/portsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:padding="16dp"
            android:elevation="2dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvPortsInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2 CCS Ports, 1 Type2 Port"
                android:textSize="14sp"
                android:textColor="#333333"/>

            <TextView
                android:id="@+id/tvPortStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2 Available • 1 Occupied"
                android:textSize="13sp"
                android:textColor="#666666"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- PRICING & HOURS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@android:color/white"
                android:padding="16dp"
                android:elevation="2dp"
                android:layout_marginEnd="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="💰 Pricing"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#666666"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tvPricing"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="₹12.5/kWh"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#2E7D32" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@android:color/white"
                android:padding="16dp"
                android:elevation="2dp"
                android:layout_marginStart="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🕒 Hours"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#666666"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tvHours"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="24/7"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#1976D2" />
            </LinearLayout>
        </LinearLayout>

        <!-- LOCATION INFO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📍 Location"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#311B92"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:padding="16dp"
            android:elevation="2dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Charger Type: CCS"
                android:textSize="14sp"
                android:textColor="#333333"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvLat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Latitude: 13.0827"
                android:textSize="13sp"
                android:textColor="#666666"
                android:layout_marginBottom="2dp"/>

            <TextView
                android:id="@+id/tvLng"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Longitude: 80.2707"
                android:textSize="13sp"
                android:textColor="#666666"/>
        </LinearLayout>

        <!-- RATINGS (PLACEHOLDER) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⭐ Rating and Reviews"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#311B92"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:padding="16dp"
            android:elevation="2dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⭐⭐⭐⭐☆ 4.2/5.0"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#F57C00"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Based on 127 reviews"
                android:textSize="13sp"
                android:textColor="#666666"/>
        </LinearLayout>

        <!-- ACTION BUTTONS -->
        <Button
            android:id="@+id/btnRoute"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="🗺️  VIEW ROUTE"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/btn_primary"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnFeatures"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="🔧 FEATURES"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:background="@drawable/btn_primary"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnShare"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="📤 SHARE"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:background="@drawable/btn_primary"
                android:layout_marginStart="8dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
