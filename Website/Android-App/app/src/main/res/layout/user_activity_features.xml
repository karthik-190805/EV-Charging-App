<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:padding="12dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Title -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="FEATURES"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/sea_blue_dark"
            android:gravity="center"
            android:padding="8dp" />

        <!-- Back -->
        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← BACK"
            android:textColor="@color/white"
            android:background="@drawable/btn_primary"
            android:layout_gravity="center"
            android:layout_marginBottom="12dp" />

        <!-- Empty -->
        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No features available for this station."
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:padding="10dp"
            android:visibility="gone" />

        <!-- ===== Availability Status (no action buttons) ===== -->
        <TextView
            android:id="@+id/hAvailability"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AVAILABILITY STATUS"
            android:textColor="@color/sea_blue_dark"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="8dp" />

        <LinearLayout
            android:id="@+id/listAvailability"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginBottom="8dp" />

        <!-- ===== Nearby Restaurants ===== -->
        <TextView
            android:id="@+id/hRestaurants"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="NEARBY RESTAURANTS"
            android:textColor="@color/sea_blue_dark"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="8dp" />

        <LinearLayout
            android:id="@+id/listRestaurants"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginBottom="8dp" />

        <!-- ===== Nearby Cafes ===== -->
        <TextView
            android:id="@+id/hCafes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="NEARBY CAFES"
            android:textColor="@color/sea_blue_dark"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="8dp" />

        <LinearLayout
            android:id="@+id/listCafes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginBottom="8dp" />

        <!-- ===== Nearby Medical ===== -->
        <TextView
            android:id="@+id/hMedical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="NEARBY MEDICAL"
            android:textColor="@color/sea_blue_dark"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="8dp" />

        <LinearLayout
            android:id="@+id/listMedical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginBottom="8dp" />

    </LinearLayout>
</ScrollView>
