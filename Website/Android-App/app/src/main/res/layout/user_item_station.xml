<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#FFFFFF"
    android:layout_marginBottom="8dp">

    <!-- HEADER ROW: Status Emoji + Name + Availability Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvStatusEmoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🟢"
            android:textSize="20sp"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/tvName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Station Name"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#311B92"
            android:ellipsize="end"
            android:maxLines="1"/>

        <TextView
            android:id="@+id/tvAvailability"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Available"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/badge_available"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

    <!-- PORT INFO ROW -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvPortInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="2/3 CCS, 1/1 Type2"
            android:textSize="14sp"
            android:textColor="#555555"
            android:drawablePadding="4dp"/>

        <TextView
            android:id="@+id/tvPricing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹12.5/kWh"
            android:textSize="13sp"
            android:textColor="#2E7D32"
            android:textStyle="bold"
            android:layout_marginStart="12dp"/>
    </LinearLayout>

    <!-- BOTTOM INFO ROW: Distance + ETA + Operating Hours -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <TextView
            android:id="@+id/tvDistance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2.3 km"
            android:textSize="12sp"
            android:textColor="#666666"
            android:drawablePadding="4dp"/>

        <TextView
            android:id="@+id/tvETA"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="• 8 min"
            android:textSize="12sp"
            android:textColor="#666666"
            android:layout_marginStart="8dp"/>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <TextView
            android:id="@+id/tvOperatingHours"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="24/7"
            android:textSize="12sp"
            android:textColor="#1976D2"
            android:textStyle="bold"/>
    </LinearLayout>

</LinearLayout>
