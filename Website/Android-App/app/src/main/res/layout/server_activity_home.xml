<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white"
    tools:context=".server.HomeActivity_server">

    <!-- 🗺️ Top Half – Map Section -->
    <org.osmdroid.views.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- ⚙️ Bottom Half – Scrollable Station Panel -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/stationPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_margin="12dp"
            android:background="@drawable/bg_route_panel"
            android:padding="12dp">

            <!-- 🔹 Station Name -->
            <TextView
                android:id="@+id/tvStationName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Station Name"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/sea_blue_dark"
                android:layout_marginBottom="8dp" />

            <!-- 🔹 Station Type -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Station Type"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:layout_marginTop="4dp" />

            <Spinner
                android:id="@+id/spinnerStationType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_edittext"
                android:padding="8dp"
                android:layout_marginTop="4dp" />

            <!-- 🔹 Number of Chargers -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Number of Chargers Installed"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:layout_marginTop="8dp" />

            <NumberPicker
                android:id="@+id/npChargers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp" />

            <!-- 🔹 Price per kWh -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Price per kWh (₹)"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:layout_marginTop="8dp" />

            <NumberPicker
                android:id="@+id/npPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp" />

            <!-- 🔹 Operating Hours -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Operating Hours"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:layout_marginTop="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:weightSum="2"
                android:layout_marginTop="4dp">

                <TimePicker
                    android:id="@+id/startTimePicker"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:timePickerMode="spinner" />

                <TimePicker
                    android:id="@+id/endTimePicker"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:timePickerMode="spinner" />
            </LinearLayout>

            <!-- 🔹 Online/Offline Toggle -->
            <ToggleButton
                android:id="@+id/toggleStationStatus"
                android:textOn="ONLINE"
                android:textOff="OFFLINE"
                android:backgroundTint="@color/sea_blue"
                android:textColor="@color/white"
                android:layout_marginTop="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- 🔹 Save Button -->
            <Button
                android:id="@+id/btnSaveStationInfo"
                android:text="Save Station Details"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@drawable/btn_primary"
                android:layout_marginTop="12dp"
                android:layout_width="match_parent"
                android:layout_height="48dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
