<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white"
    tools:context=".user.HomeActivity">

    <!-- Map -->
    <org.osmdroid.views.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Network Status and Timestamp Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        android:background="@color/white">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <!-- Network Status Indicator -->
            <TextView
                android:id="@+id/tvNetworkStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📡 WiFi"
                android:textColor="@android:color/holo_green_dark"
                android:textSize="12sp"
                android:padding="4dp" />

            <!-- Last Updated Timestamp -->
            <TextView
                android:id="@+id/tvLastUpdated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Updated: Just now"
                android:textSize="11sp"
                android:textColor="@android:color/darker_gray"
                android:padding="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Route input panel -->
    <LinearLayout
        android:id="@+id/routePanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_margin="12dp"
        android:background="@drawable/bg_route_panel"
        android:padding="12dp">

        <CheckBox
            android:id="@+id/cbUseMyLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Use my current location as Start"
            android:textColor="@color/text_primary" />

        <EditText
            android:id="@+id/etStart"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:hint="Start location"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/sea_blue_dark"
            android:background="@drawable/rounded_edittext"
            android:paddingLeft="12dp"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/etDestination"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:hint="Destination"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/sea_blue_dark"
            android:background="@drawable/rounded_edittext"
            android:paddingLeft="12dp"
            android:layout_marginTop="8dp" />

        <!-- Buttons Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <!-- Set Route button -->
            <Button
                android:id="@+id/btnSetRoute"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Set Route"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@drawable/btn_primary" />

            <Space
                android:layout_width="8dp"
                android:layout_height="wrap_content" />

            <!-- Clear button -->
            <Button
                android:id="@+id/btnClear"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Clear"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@drawable/btn_primary" />

            <Space
                android:layout_width="8dp"
                android:layout_height="wrap_content" />

            <!-- Refresh button -->
            <Button
                android:id="@+id/btnRefresh"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="↻ Refresh"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@drawable/btn_primary" />

        </LinearLayout>
    </LinearLayout>

    <!-- Station list -->
    <ListView
        android:id="@+id/listViewStations"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:divider="@android:color/transparent"
        android:dividerHeight="8dp"
        android:padding="8dp" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:visibility="gone" />

</LinearLayout>
